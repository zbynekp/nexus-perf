# Example Environment Configuration
# Copy to .env and fill in your values, then: source .env

# ============================================
# Nexus Connection Settings (Required)
# ============================================
export NEXUS_PERF_NEXUS_ENDPOINT=https://nexus.example.com
export NEXUS_PERF_USERNAME=admin
export NEXUS_PERF_PASSWORD=changeme
export NEXUS_PERF_REPOSITORY_NAME=test-repo

# ============================================
# Repository Settings
# ============================================
# Format: RAW or MAVEN
export NEXUS_PERF_FORMAT=RAW

# ============================================
# TLS/SSL Settings
# ============================================
# Path to custom CA certificate (optional)
# export NEXUS_PERF_CA_PATH=/path/to/ca.pem

# Skip TLS certificate verification (NOT recommended for production)
# export NEXUS_PERF_SKIP_VERIFY=true

# ============================================
# Test Parameters
# ============================================
# Number of test files
export NEXUS_PERF_NUM_FILES=50

# Number of concurrent threads
export NEXUS_PERF_NUM_THREADS=8

# Size of each test file in bytes
# 1MB = 1048576, 5MB = 5242880, 10MB = 10485760, 100MB = 104857600
export NEXUS_PERF_FILE_SIZE=5242880

# ============================================
# Logging and Debugging
# ============================================
# Verbosity: 0=error, 1=info, 2=debug, 3=trace
export NEXUS_PERF_VERBOSITY=1

# ============================================
# Test Behavior
# ============================================
# Skip upload test (only download)
# export NEXUS_PERF_SKIP_UPLOAD=true

# Skip download test (only upload)
# export NEXUS_PERF_SKIP_DOWNLOAD=true

# Keep uploaded files after test (don't delete)
# export NEXUS_PERF_KEEP_FILES=true

# ============================================
# Profile Configurations
# ============================================

# Baseline Test (uncomment to use)
# BASELINE_CONFIG=1
# NEXUS_PERF_NUM_FILES=100
# NEXUS_PERF_NUM_THREADS=8
# NEXUS_PERF_FILE_SIZE=1048576

# Stress Test (uncomment to use)
# STRESS_CONFIG=1
# NEXUS_PERF_NUM_FILES=500
# NEXUS_PERF_NUM_THREADS=64
# NEXUS_PERF_FILE_SIZE=5242880

# Throughput Test (uncomment to use)
# THROUGHPUT_CONFIG=1
# NEXUS_PERF_NUM_FILES=10
# NEXUS_PERF_NUM_THREADS=4
# NEXUS_PERF_FILE_SIZE=104857600
