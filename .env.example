# Example environment configuration for nexus-perf.
#
# Copy to .env and fill in the required values.
#
# Usage:
#   docker compose:  works as-is — Compose reads KEY=VALUE files natively.
#   bash / zsh:      set -a; source .env; set +a
#
# Do NOT add "export" prefixes — that breaks docker compose env-file parsing.

# ============================================
# Nexus Connection Settings (Required)
# ============================================
NEXUS_PERF_NEXUS_ENDPOINT=https://nexus.example.com
NEXUS_PERF_USERNAME=admin
NEXUS_PERF_PASSWORD=changeme
NEXUS_PERF_REPOSITORY_NAME=test-repo

# ============================================
# Repository Settings
# ============================================
# Format: RAW or MAVEN (default: RAW)
NEXUS_PERF_FORMAT=RAW

# ============================================
# TLS/SSL Settings
# ============================================
# Path to a custom CA certificate bundle (optional)
# NEXUS_PERF_CA_PATH=/path/to/ca.pem

# Skip TLS certificate verification — NOT recommended for production
# NEXUS_PERF_SKIP_VERIFY=true

# ============================================
# Test Parameters
# ============================================
# Number of test files (default: 10)
NEXUS_PERF_NUM_FILES=50

# Number of concurrent upload/download threads (default: 4)
NEXUS_PERF_NUM_THREADS=8

# Size of each test file in bytes (default: 1 000 000).
# Uses SI megabytes: 1 MB = 1 000 000 bytes, 5 MB = 5 000 000, 10 MB = 10 000 000.
NEXUS_PERF_FILE_SIZE=5000000

# ============================================
# Test Behaviour
# ============================================
# Run only the download phase (skip upload)
# NEXUS_PERF_SKIP_UPLOAD=true

# Run only the upload phase (skip download)
# NEXUS_PERF_SKIP_DOWNLOAD=true

# Keep uploaded files after the test (do not delete them)
# NEXUS_PERF_KEEP_FILES=true

# ============================================
# Logging and Output
# ============================================
# Verbosity: 0=error, 1=info (default), 2=debug, 3=trace
NEXUS_PERF_VERBOSITY=1

# Write structured JSON logs to a file instead of stdout
# NEXUS_PERF_LOG_FILE=/tmp/nexus-perf.log

# Print per-file timing and throughput after each transfer
# NEXUS_PERF_VERBOSE_METRICS=true

# ============================================
# Example Profiles (copy-paste the block you want)
# ============================================

# -- Baseline: many small files, moderate concurrency --
# NEXUS_PERF_NUM_FILES=100
# NEXUS_PERF_NUM_THREADS=8
# NEXUS_PERF_FILE_SIZE=1000000

# -- Stress: high volume, high concurrency --
# NEXUS_PERF_NUM_FILES=500
# NEXUS_PERF_NUM_THREADS=64
# NEXUS_PERF_FILE_SIZE=5000000

# -- Throughput: few large files --
# NEXUS_PERF_NUM_FILES=10
# NEXUS_PERF_NUM_THREADS=4
# NEXUS_PERF_FILE_SIZE=100000000
